# ═══ CONDO PLAY CRM — Template de variaveis de ambiente ═══
#
# Copiar para .env.local (dev) e configurar no Vercel (prod).
# NAO commitar arquivo com valores preenchidos. .env* ja esta no .gitignore.
#
# IDENTIDADE DESTE AMBIENTE: condoplayy@gmail.com
# Todas as keys abaixo devem ser geradas NESTA conta, NUNCA reusar keys da Wash Me.

# ─── SUPABASE (novo projeto sob condoplayy@gmail.com) ────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<NOVO-PROJECT-REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<NOVA-ANON-KEY-publica>
# Service Role Key: Settings → API → service_role (SECRETA, nunca expor no client)
SUPABASE_SERVICE_KEY=<NOVA-SERVICE-KEY-secreta>

# ─── EVOLUTION API (REMOVIDO — nao usar) ─────────────────────────────────────
# Decidido em 2026-04-15: CondoPlay nao vai usar Evolution API.
# Integracao WhatsApp futura sera redefinida (WABA oficial ou outra).
# As variaveis abaixo ficam comentadas como referencia historica.
# NEXT_PUBLIC_EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# NEXT_PUBLIC_EVOLUTION_INSTANCE=

# URL publica da app (Vercel). Usada em webhooks de volta.
NEXT_PUBLIC_APP_URL=https://condoplay.vercel.app

# ─── LLMs (NOVAS keys, geradas na conta condoplayy@gmail.com) ────────────────
# Groq: https://console.groq.com/keys
GROQ_API_KEY=<NOVA-groq-key>
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<NOVA-gemini-key>
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=<NOVA-anthropic-key>

# ─── APOLLO (ainda nao usado, mas previsto) ──────────────────────────────────
# Deixar comentado ate ativar.
# APOLLO_API_KEY=

# ─── CONFIGURACAO DE TENANT PADRAO ───────────────────────────────────────────
# UUID do tenant default usado pelos agentes HAWKEYE/LOKI.
# Pegar do banco novo apos rodar o seed: select id from tenants where name='Condo Play';
DEFAULT_TENANT_ID=<uuid-do-tenant-padrao>

# ─── OBSERVABILIDADE (opcional, recomendado futuro) ──────────────────────────
# SENTRY_DSN=
# LOGTAIL_SOURCE_TOKEN=
